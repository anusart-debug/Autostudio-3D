rules_version = '2';
// AUTOSTUDIO 3D — กฎความปลอดภัยของระบบขอสิทธิ์การใช้งาน (เฟส 6)
//
// เอกสาร 1 ใบ = ผู้ใช้ 1 คน เก็บที่ users/<email> เช่น users/anusart@planbmedia.co.th
// { email, name, status: "pending"|"approved"|"rejected", requestedAt, reviewedAt, reviewedBy }
//
// กฎ: ผู้ใช้อ่านได้แค่เอกสารของตัวเอง, สร้างคำขอของตัวเองได้ครั้งเดียว (บังคับ status=pending
// กันตั้งสถานะอนุมัติเองตอนสร้าง), แก้สถานะ (อนุมัติ/ปฏิเสธ) ได้เฉพาะแอดมิน — ห้ามลบเอกสาร
// เพื่อให้มีร่องรอยตรวจสอบเสมอว่าใครเคยขอ/เคยได้รับสิทธิ์บ้าง
//
// ผู้ดูแล: แก้อีเมลตรงนี้เมื่อเปลี่ยนคนดูแลระบบ — เป็นค่าเดียวที่ต้องแก้ (ดู ADMIN_EMAIL
// ใน src/js/70-auth.web.js ด้วย ทั้งสองที่ต้องตรงกันเสมอ)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{email} {
      allow read: if request.auth != null &&
                     (request.auth.token.email == email ||
                      request.auth.token.email == "anusart@planbmedia.co.th");

      allow create: if request.auth != null &&
                       request.auth.token.email == email &&
                       request.resource.data.email == email &&
                       request.resource.data.status == "pending";

      allow update: if request.auth != null &&
                       request.auth.token.email == "anusart@planbmedia.co.th";

      allow delete: if false;
    }
  }
}
